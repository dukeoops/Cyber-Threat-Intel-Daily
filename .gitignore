# .gitignore for cyber-threat-intel-daily

# ─── 配置文件（含敏感信息，不得提交）───────────────────────────────
config.json
*.secret
*.key
.env
.env.*

# ─── 生成物输出目录 ───────────────────────────────────────────────
output/
/tmp/intel_*

# ─── Python 缓存 ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ─── 虚拟环境 ────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ─── macOS ───────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── 编辑器 ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── 日志 ────────────────────────────────────────────────────────
logs/
*.log
